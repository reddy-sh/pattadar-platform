# PostgreSQL DSN for the pattadar database (RDS in AWS)
APP_PG_DSN=postgresql://user:password@localhost:5432/pattadar
# Anthropic API key for the document-extraction endpoints
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# Shared secret for /cron/inactivity-check — MUST be set, endpoint is open without it
# TODO(Phase 1): required at startup — service must fail fast if unset
CRON_SECRET=REPLACE_ME
# Public base URL for invite/verification links: {APP_PUBLIC_URL}/verify/{token}
# TODO(Phase 1): required at startup — service must fail fast if unset
APP_PUBLIC_URL=https://pattadar.com
# Uvicorn worker count (init_db advisory lock makes >1 safe, start with 1)
UVICORN_WORKERS=1
# Days of inactivity before the owner is asked to check in
INACTIVITY_CHECKIN_DAYS=150
# Days of inactivity before escalation to family notifiers begins
INACTIVITY_ESCALATE_DAYS=180
# Gap in days between successive priority-level notifications
INACTIVITY_PRIORITY_GAP_DAYS=7
# Email provider: stub | resend
NOTIFY_EMAIL_PROVIDER=stub
# Resend API key (required when NOTIFY_EMAIL_PROVIDER=resend)
RESEND_API_KEY=
# From address for outbound email
NOTIFY_EMAIL_FROM=
# SMS provider: stub | msg91
NOTIFY_SMS_PROVIDER=stub
# MSG91 auth key (required when NOTIFY_SMS_PROVIDER=msg91)
MSG91_AUTHKEY=
# MSG91 sender id
MSG91_SENDER=
# MSG91 DLT template id (India DLT compliance)
MSG91_DLT_TEMPLATE_ID=
# WhatsApp provider: stub | meta
NOTIFY_WA_PROVIDER=stub
# Meta WhatsApp Cloud API token (required when NOTIFY_WA_PROVIDER=meta)
WHATSAPP_TOKEN=
# Meta WhatsApp phone number id
WHATSAPP_PHONE_ID=
