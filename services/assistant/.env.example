# PostgreSQL — conversations, ordered messages, attachments, and model catalog.
PG_HOST=localhost
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=hub

# Independent, read-only historical public-record corpus. Prefer a dedicated
# role with SELECT-only grants. Set either DATABASE_URL or the PG_* fields.
# Leaving both URL and host empty keeps chat/files available while reporting
# the public-record capability as temporarily unavailable.
PUBLIC_RECORDS_DATABASE_URL=
PUBLIC_RECORDS_PG_HOST=
PUBLIC_RECORDS_PG_PORT=5432
PUBLIC_RECORDS_PG_USER=
PUBLIC_RECORDS_PG_PASSWORD=
PUBLIC_RECORDS_PG_DATABASE=pattadar
PUBLIC_RECORDS_SCHEMA=land
PUBLIC_RECORDS_TABLE=real_estate_records
PUBLIC_RECORDS_PARTY_TABLE=party
PUBLIC_RECORDS_BOUNDARY_VECTORS_TABLE=boundary_vectors
PUBLIC_RECORDS_QUERY_TIMEOUT_MS=25000

# Semantic boundary search is optional because bge-m3 is a large lazy-loaded
# model. Enable only in an image that installs requirements-semantic.txt.
PUBLIC_RECORDS_EMBEDDINGS_ENABLED=0
PUBLIC_RECORDS_EMBED_MODEL=BAAI/bge-m3
PUBLIC_RECORDS_EMBED_DIM=1024
PUBLIC_RECORDS_EMBED_DEVICE=auto

# Anthropic API key for chat and model-catalog fallback fetch.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# Used only when enabled in the administrator-owned model catalog.
ASSISTANT_MODEL=claude-sonnet-4-6
# Bound silent Claude SDK runs below the gateway's 200-second stream timeout.
ASSISTANT_CHAT_TIMEOUT_SECONDS=180
PORT=8080
# Durable S3 storage in production. Empty uses PostgreSQL BYTEA (local/dev).
ASSISTANT_ATTACHMENTS_BUCKET=
ASSISTANT_UPLOAD_DIR=/tmp/assistant_uploads
ASSISTANT_MAX_UPLOAD_BYTES=10485760
# Optional seed prompt directory ({id}.md). Unset uses the database then the
# built-in default prompt.
PROMPT_SEED_DIR=
