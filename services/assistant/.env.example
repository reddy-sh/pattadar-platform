# PostgreSQL — conversations, attachments, LangGraph checkpoints, model catalog.
# PG_DATABASE defaults to "hub" (rhub's code default of 'rhub' was a known trap).
PG_HOST=localhost
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=hub
# Anthropic API key for the chat model (and the model-catalog fallback fetch)
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# Default chat model (overridable per conversation; must be in the catalog)
ASSISTANT_MODEL=claude-sonnet-4-6
# MCP gateway streamable-HTTP endpoint. EMPTY (the default) is the supported
# no-MCP path: the assistant runs with only its built-in navigate/page-action tools.
MCP_URL=
# Bearer token for the MCP gateway (service-to-service), when MCP_URL is set
MCP_AUTH_TOKEN=
# Listen port (pattadar service convention)
PORT=8080
# Attachment storage directory (local disk; ephemeral is acceptable)
ASSISTANT_UPLOAD_DIR=/tmp/assistant_uploads
# Attachment upload cap in bytes
ASSISTANT_MAX_UPLOAD_BYTES=10485760
# Optional directory of seed prompt markdown files ({id}.md). Unset = use the
# agent_prompts table, then the built-in default prompt.
PROMPT_SEED_DIR=
