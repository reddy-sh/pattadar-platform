# Auth0 tenant domain (e.g. your-tenant.us.auth0.com)
AUTH0_DOMAIN=
# Auth0 API audience for JWT validation
AUTH0_AUDIENCE=
# PostgreSQL DSN for gateway tables (storage metadata, model catalog, rbac)
PG_DSN=
# S3 endpoint (regional S3 endpoint; minio-py client points here)
S3_ENDPOINT=
# Static access key for the documents bucket
S3_ACCESS_KEY=
# Static secret key for the documents bucket
S3_SECRET_KEY=
# Use TLS to the S3 endpoint
S3_SECURE=true
# Documents bucket name (SSE-KMS, versioned, all public access blocked)
STORAGE_BUCKET=
# Upload size cap in bytes (uploads are full-buffered in memory)
STORAGE_MAX_UPLOAD_BYTES=104857600
# Anthropic API key for the model-catalog admin provider
ANTHROPIC_API_KEY=
# Shared secret for internal service-to-service calls
INTERNAL_SERVICE_TOKEN=
