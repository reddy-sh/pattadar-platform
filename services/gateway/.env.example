# Cognito user pool id (issuer = https://cognito-idp.<region>.amazonaws.com/<pool-id>)
COGNITO_USER_POOL_ID=
# Cognito app client id — validated against the token's client_id claim (access tokens have no aud)
COGNITO_CLIENT_ID=
# Cognito region
COGNITO_REGION=ap-south-1
# PostgreSQL for gateway tables (storage metadata, model catalog)
PG_HOST=
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=hub
# Documents bucket name (SSE-KMS, versioned, all public access blocked).
# Bytes are accessed via boto3 with task-role IAM creds — NO static keys.
STORAGE_BUCKET=
# Upload size cap in bytes (uploads are full-buffered in memory)
STORAGE_MAX_UPLOAD_BYTES=104857600
# Downstream pattadar api service (proxied at /api/gateway/pattadar/*)
API_BASE_URL=
# Downstream assistant service (streaming proxy at /api/gateway/assistant/*)
ASSISTANT_BASE_URL=
# Comma-separated super-admin user ids for /api/gateway/admin/* (fail closed)
ADMIN_USER_IDS=sankara.telukutla
# AWS region for the S3 client
AWS_REGION=ap-south-1
# Anthropic API key for the model-catalog admin provider (model sync)
ANTHROPIC_API_KEY=
