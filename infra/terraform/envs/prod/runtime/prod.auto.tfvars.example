# Copy to prod.auto.tfvars (git-ignored) and adjust. No secrets in tfvars.

region          = "ap-south-1"
tf_state_bucket = "pattadar-terraform-state-<ACCOUNT_ID>"

# Image tags are normally pinned by deploy.yml (-var on apply); "latest" is
# only a bootstrap convenience.
# gateway_image_tag = "sha-abc1234"
# api_image_tag     = "sha-abc1234"

# ECS host (one instance runs gateway, api and assistant):
# instance_type = "t4g.medium"

# 120 by default. Raise after the CloudFront "Response timeout per origin"
# quota increase (the iOS synchronous passbook read needs it at cutover):
# cloudfront_origin_read_timeout = 180

# App secrets are SSM SecureStrings created OUT OF BAND (never in tfvars or
# Terraform state) under the persistent CMK, before the first runtime apply:
#   /pattadar/prod/db-app-password                  PG_PASSWORD (all three services)
#   /pattadar/prod/cron-secret                      CRON_SECRET + the cron connection header
#   /pattadar/prod/anthropic-api-key                ANTHROPIC_API_KEY
#   /pattadar/prod/internal-proxy-secret-api        gateway -> api only
#   /pattadar/prod/internal-proxy-secret-assistant  gateway -> assistant only
# e.g. aws ssm put-parameter --type SecureString --key-id alias/pattadar-prod \
#        --name /pattadar/prod/<name> --value file://<file>
# The --key-id is required: platform-up refuses a parameter under the default
# aws/ssm key, which any principal in the account (the instance role too) can
# decrypt through SSM. Its check reads names and key ids, never values.

# First WAF rollout can observe before blocking:
# waf_block_mode = false
