# Copy to dev.auto.tfvars (git-ignored) and adjust. No secrets in tfvars.
# Dev posture: no CDN/WAF (the SPA runs locally via `bun dev` and talks
# straight to the dev ALB), short log retention, single task per service.

region          = "ap-south-1"
tf_state_bucket = "pattadar-terraform-state-<ACCOUNT_ID>"

log_retention_days = 30
desired_count      = 1
enable_cdn         = false # dev talks straight to the ALB
enable_waf         = false

# Dev must NOT claim prod's api.pattadar.com — use a dev host in the shared zone:
api_domain   = "api-dev.pattadar.com"
api_base_url = "https://api-dev.pattadar.com"

# Shared AWS account (dev persistent has manage_dns = false)? Point at prod's
# zone: `terraform -chdir=../../prod/persistent output -raw route53_zone_id`
# route53_zone_id = "Z0123456789ABCDEFGHIJ"

# Optional: skip the down-flip dance for a throwaway dev database:
# deletion_protection = false

# App secrets are SSM SecureStrings created OUT OF BAND (never in tfvars or
# Terraform state) under the persistent CMK, before the first runtime apply:
#   /pattadar/dev/db-app-password                  PG_PASSWORD (all three services)
#   /pattadar/dev/cron-secret                      CRON_SECRET + the cron connection header
#   /pattadar/dev/anthropic-api-key                ANTHROPIC_API_KEY
#   /pattadar/dev/internal-proxy-secret-api        gateway -> api only
#   /pattadar/dev/internal-proxy-secret-assistant  gateway -> assistant only
# e.g. aws ssm put-parameter --type SecureString --key-id alias/pattadar-dev \
#        --name /pattadar/dev/<name> --value file://<file>
# The --key-id is required: platform-up refuses a parameter under the default
# aws/ssm key, which any principal in the account can decrypt through SSM. Its
# check reads names and key ids, never values.
