# Cognito auth for the web app. Track B (Terraform) creates the user pool,
# app client, and auth domain, and fills these values per environment.
#
# FOUNDER RULE: customers never see a non-pattadar.com URL. Email/password
# sign-in/sign-up/confirm/reset happen natively on OUR pages (/login,
# /signup, /forgot-password) via the Cognito API — zero redirects. Only
# social logins (OAuth requires a redirect) use VITE_COGNITO_DOMAIN.
#
# MOCK MODE: leave VITE_COGNITO_AUTHORITY unset/empty and auth becomes a
# local stub (auto-signed-in dev user, visible "Auth mocked — dev only"
# chip) so `bun run dev` works before the pool exists.

# OIDC issuer: https://cognito-idp.ap-south-1.amazonaws.com/<userPoolId>
# The native SRP client parses the pool id from the tail of this URL.
VITE_COGNITO_AUTHORITY=

# App client id of the SPA client (public client, PKCE, no secret).
VITE_COGNITO_CLIENT_ID=

# Auth domain used ONLY for social logins (OAuth redirect) and their logout.
# Will be the custom domain auth.pattadar.com in production; pilot prefix
# domain until then: pattadar-auth-<env>.auth.ap-south-1.amazoncognito.com
VITE_COGNITO_DOMAIN=

# Redirect back into the SPA after a SOCIAL login. Defaults to
# <origin>/auth/callback when unset; set explicitly if they differ.
VITE_COGNITO_REDIRECT_URI=

# Comma-separated social buttons to show on /login: any of
# "Google,Facebook,Apple". Leave empty until the identity providers are
# enabled in Cognito — empty means no social section is rendered.
VITE_SOCIAL_PROVIDERS=
