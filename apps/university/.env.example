# Same Cognito user pool as pattadar.com; use a dedicated public app client.
VITE_COGNITO_AUTHORITY=https://cognito-idp.ap-south-1.amazonaws.com/POOL_ID
VITE_COGNITO_CLIENT_ID=UNIVERSITY_PUBLIC_CLIENT_ID
VITE_COGNITO_DOMAIN=https://auth.pattadar.com
VITE_COGNITO_REDIRECT_URI=http://localhost:5181/auth/callback

# Local API target used only by Vite's development proxy.
VITE_API_PROXY_TARGET=http://localhost:8080
